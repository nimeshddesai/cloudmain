<header>
      <nav aria-label="Main">
        <a class="brand" href="/">
          <img src="/images/Fabriant.png" alt="Fabriant" class="brand-logo" />
          <div>
            <span>{{ site.name }}</span>
            <small class="brand-tagline">{{ site.tagline }}</small>
          </div>
        </a>
        <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-links">
          <span></span><span></span><span></span>
        </button>
        <div class="nav-links" id="nav-links">
          {%- for item in site.nav %}
          <a href="{{ item.url }}"{% if page.url and page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a>
          {%- endfor %}
          <a class="cta" href="{{ site.cta.url }}"{% if page.url == site.cta.url %} aria-current="page"{% endif %}>
            {{ site.cta.label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </nav>
    </header>
